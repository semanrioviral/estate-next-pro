{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=uehajzlrvqvirtsubsdq",
      "headers": {
        "Authorization": "Bearer env:SUPABASE_MCP_TOKEN"
      },
      "enabled": true
    },

    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-af24ee81-dae2-4da1-9e71-8c46227cfbe1"
      },
      "enabled": true
    },

    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "env:GITHUB_TOKEN"
      },
      "enabled": true
    },

    "vercel": {
      "type": "remote",
      "url": "https://mcp.vercel.com",
      "enabled": true
    },

    "puppeteer": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-puppeteer"],
      "enabled": true
    },

    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },

    "pagespeed": {
      "type": "local",
      "command": [
        "cmd",
        "/c",
        "set GOOGLE_API_KEY=AIzaSyCwLfGBKVfOWdNWNWRIAxtzLJmNK1VgLtU&& node C:/MCP/pagespeed-insights-mcp/dist/index.js"
      ],
      "enabled": true
    },

    "google-search-console": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "google-searchconsole-mcp"
      ],
      "enabled": true
    }
  }
}